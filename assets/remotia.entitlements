<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for the Mac App Store -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- RDP/VNC/SSH are outgoing connections -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- The embedded RDP helper is launched as a child process -->
	<key>com.apple.security.inherit</key>
	<true/>

	<!-- If you later need keychain access from the sandbox, add a group and
	     enable this (and create the item with the same access group):
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.remotia.client</string>
	</array>
	-->
</dict>
</plist>
